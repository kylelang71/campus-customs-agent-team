# Copy to .env (in this HW5 folder) and fill in, or rely on the "AI
# Foundations" root .env — agent.py loads both locations and will not
# overwrite a value that's already set.

PORTKEY_API_KEY=your-portkey-key-here

# Optional overrides; these defaults are what agent.py uses.
PORTKEY_MODEL=gpt-6-luna
PORTKEY_BASE_URL=https://api.portkey.ai/v1
